gem = "https://generativelanguage.googleapis.com/v1beta/openai"
for m in ["gemini-2.5-flash", "gemini-3.8-flash"]:
    r = httpx.post(gem + "/chat/completions", headers={"Authorization": f"Bearer {g}"}, timeout=60,
                   json={"model": m, "messages": [{"role": "user", "content": "say pong"}], "max_tokens": 50})
    print("gemini", m, r.status_code, " ".join(r.text.replace(g, "<KEY>").split())[:160])
for path in ["/api/models", "/api/v1/messages"]:
    r = httpx.request("GET" if "models" in path else "POST", s.openwebui_base_url.rstrip("/") + path,
                      headers={"x-api-key": w, "Authorization": f"Bearer {w}"}, timeout=30,
                      json=None if "models" in path else {"model": "gpt-5", "messages": [{"role": "user", "content": "hi"}], "max_tokens": 5})
    print("openwebui", path, r.status_code, " ".join(r.text.replace(w, "<KEY>").split())[:120])
EOF
