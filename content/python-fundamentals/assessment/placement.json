      "difficulty": "core",
      "grader": {
        "type": "rubric",
        "criteria": [
          {
            "id": "c1",
            "text": "Says print shows a value on screen only."
          },
          {
            "id": "c2",
            "text": "Says return hands a value back to the caller so it can be stored or used."
          }
        ],
        "pass_rule": "all",
        "reference_answer": "print displays a value for a person to read; return gives the value back to the code that called the function, so it can be saved in a variable or used in a calculation."
      },
