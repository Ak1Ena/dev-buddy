          },
          {
            "args": [
              -1,
              -7
            ],
            "expected": -1
          }
        ]
      },
      "reference_solution": "def bigger(a, b):\n    if a > b:\n        return a\n    return b\n",
      "must_fail": [
        {
          "code": "def bigger(a, b):\n    if a > b:\n        print(a)\n    else:\n        print(b)\n",
          "why": "prints instead of returning",
          "misconception_id": "python.functions:print-vs-return"
        },
        {
          "code": "def bigger(a, b):\n    return a\n",
          "why": "ignores b"
        }
      ],
      "misconception_ids": [
        "python.functions:print-vs-return"
      ]
