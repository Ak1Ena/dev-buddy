# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./devbuddy.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/devbuddy

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: anthropic | openrouter | openai | ollama
LLM_PROVIDER=anthropic

# Model name — format depends on provider:
#   anthropic   → claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5-20251001
#   openrouter  → anthropic/claude-3.5-sonnet | openai/gpt-4o | google/gemini-pro
#                 meta-llama/llama-3.1-70b-instruct | mistralai/mistral-7b-instruct
#   openai      → gpt-4o | gpt-4o-mini | gpt-4-turbo
#   ollama      → llama3.2 | mistral | codellama (whatever you have pulled locally)
LLM_MODEL=claude-sonnet-4-6

# ── Provider API keys (only the one matching LLM_PROVIDER is required) ───────
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── OpenRouter optional metadata (shown on openrouter.ai dashboard) ───────────
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=devBuddy AI

# ── Ollama (local models, no API key needed) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
